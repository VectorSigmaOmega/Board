[Unit]
Description=Collaborate API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collaborate
Group=collaborate
WorkingDirectory=/opt/collaborate/source
Environment=NODE_ENV=production
EnvironmentFile=/etc/collaborate/api.env
ExecStart=/usr/bin/node /opt/collaborate/source/apps/api/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/collaborate
UMask=0027

[Install]
WantedBy=multi-user.target
